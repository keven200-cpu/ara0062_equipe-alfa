/* Configuração geral da página */
body {
  background-color: var(--fundo);
  color: var(--texto);
  font-family: var(--fonte);
  font-size: 1rem;
  line-height: 1.6;
  margin: 0;
  padding: 0;
}

/* Estrutura central da página com a escala em rem */
main {
  max-width: 1000px;
  margin: 0 auto;
  padding: var(--e-2) var(--e-4) var(--e-4);
}

/* Respiro vertical entre as seções */
section {
  margin-bottom: var(--e-4);
}

/* Subtítulos com cores do root e hierarquia em rem */
h2 {
  color: var(--principal);
  font-size: 1.75rem;
  margin-bottom: var(--e-2);
}

h3 {
  color: var(--principal);
  font-size: 1.25rem;
  margin-bottom: var(--e-1);
}

/* Parágrafos e espaçamento entre textos */
p {
  margin-bottom: var(--e-2);
  color: var(--texto);
}

/* Links com cores da paleta e estados */
a {
  color: var(--principal);
  text-decoration: underline;
}

a:hover {
  color: var(--principal-escuro);
}

/* Imagens responsivas para não quebrar a largura da página */
img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: var(--e-2) 0;
  border-radius: 4px;
}

/* Listas (ordenadas e não ordenadas) */
ul, ol {
  margin-bottom: var(--e-2);
  padding-left: var(--e-3);
  color: var(--texto);
}

li {
  margin-bottom: var(--e-1);
}
